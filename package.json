{
  "name": "pr-ai-reviewer",
  "version": "0.3.1",
  "description": "내가 올린 PR을 감지해 이 PC의 Claude Code 또는 Codex CLI로 리뷰하는 로컬 상주 도구",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "pr-ai-reviewer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juhee200/pr-ai-reviewer.git"
  },
  "homepage": "https://github.com/juhee200/pr-ai-reviewer#readme",
  "bugs": {
    "url": "https://github.com/juhee200/pr-ai-reviewer/issues"
  },
  "keywords": [
    "code-review",
    "pull-request",
    "claude-code",
    "codex",
    "cli",
    "github"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
